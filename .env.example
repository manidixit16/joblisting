# Copy this file to `.env` and fill in what you need. All values are optional
# except where noted; the app runs with sensible defaults out of the box.

# ---- Document generation backend -------------------------------------------
# "template" = offline, no API key, rule-based (default)
# "claude"   = Anthropic Claude API (higher quality, needs ANTHROPIC_API_KEY)
# "auto"     = use Claude if a key is present, otherwise fall back to template
GENERATOR_BACKEND=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Adzuna (optional job source; free API key at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# ---- Outbound email (only used AFTER you approve an application) ------------
# Leave EMAIL_DRY_RUN=true to write .eml files to ./outbox instead of sending.
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=
FROM_NAME=

# ---- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/joblisting.db
